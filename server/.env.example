# Database Configuration
HOST=localhost
USER=root
PASS=

# Main Database (for shared data like products, orders, categories, reviews)
NAME=ecommerce

# Admin Database (for admin users and admin-specific data)
ADMIN_DB_NAME=ecommerce_admin
ADMIN_DB_HOST=localhost
ADMIN_DB_USER=root
ADMIN_DB_PASS=

# User Database (for customer users and customer-specific data)
USER_DB_NAME=ecommerce_users
USER_DB_HOST=localhost
USER_DB_USER=root
USER_DB_PASS=

# JWT Configuration
ACCESS_TOKEN_SECRET=your-access-token-secret-here
ACCESS_TOKEN_EXPIRE=1d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here
REFRESH_TOKEN_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Server Configuration
PORT=8000
NODE_ENV=development
